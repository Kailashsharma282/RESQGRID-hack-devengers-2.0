{
  "name": "@resqgrid/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/prisma-generate.js && tsc",
    "start": "node dist/main.js",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "prisma:neon:generate": "prisma generate --schema=prisma/schema.neon.prisma",
    "prisma:neon:push": "prisma db push --schema=prisma/schema.neon.prisma",
    "prisma:neon:migrate": "prisma migrate dev --schema=prisma/schema.neon.prisma",
    "seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx prisma/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@prisma/client": "^5.14.0",
    "@resqgrid/types": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.14.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
