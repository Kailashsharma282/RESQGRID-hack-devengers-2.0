datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CITIZEN
  OPERATOR
  RESPONDER
  ADMIN
}

enum IncidentCategory {
  FIRE
  FLOOD
  MEDICAL
  ACCIDENT
  STRUCTURAL
  ELECTRICAL
  SECURITY
  MISSING_PERSON
  HAZMAT
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  VERIFYING
  VERIFIED
  DISPATCHING
  RESPONDING
  ON_SCENE
  RESOLVED
  CLOSED
}

enum ResourceType {
  AMBULANCE
  FIRE_TRUCK
  RESCUE_BOAT
  MEDICAL_TEAM
  FIRE_TEAM
  POLICE_TEAM
  VOLUNTEER_TEAM
  FOOD
  WATER
  GENERATOR
  SHELTER
  FIRST_AID
  OTHER
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  ON_SCENE
  UNAVAILABLE
  MAINTENANCE
}

enum DispatchStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SCENE
  COMPLETED
  CANCELLED
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  phone        String?
  passwordHash String
  role         UserRole         @default(CITIZEN)
  avatar       String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reports      IncidentReport[]
  dispatches   Dispatch[]
  AuditLog     AuditLog[]
}

model Incident {
  id               String           @id @default(uuid())
  incidentCode     String           @unique
  title            String
  description      String
  category         IncidentCategory
  severity         IncidentSeverity
  status           IncidentStatus   @default(REPORTED)
  latitude         Float
  longitude        Float
  address          String
  affectedPeople   Int              @default(0)
  vulnerablePeople Int              @default(0)
  confidenceScore  Float            @default(0.85)
  priorityScore    Float            @default(50.0)
  source           String           @default("CITIZEN_REPORT")
  aiSummary        String?
  aiReasoning      String?
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?
  reports          IncidentReport[]
  dispatches       Dispatch[]
  notifications    Notification[]

  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([createdAt])
  @@index([latitude, longitude])
}

model IncidentReport {
  id              String    @id @default(uuid())
  incidentId      String
  reporterId      String?
  text            String
  mediaUrl        String?
  source          String    @default("WEB_APP")
  latitude        Float
  longitude       Float
  extractedData   Json?     // Native JSONB in Postgres
  confidenceScore Float     @default(0.9)
  createdAt       DateTime  @default(now())
  incident        Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reporter        User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([createdAt])
}

model Resource {
  id           String         @id @default(uuid())
  name         String
  type         ResourceType
  status       ResourceStatus @default(AVAILABLE)
  capacity     Int            @default(1)
  latitude     Float
  longitude    Float
  organization String
  contact      String
  capabilities Json           @default("[]") // Native JSONB
  metadata     Json?          // Native JSONB
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dispatches   Dispatch[]

  @@index([status])
  @@index([type])
  @@index([latitude, longitude])
}

model Dispatch {
  id          String         @id @default(uuid())
  incidentId  String
  resourceId  String
  assignedBy  String?
  status      DispatchStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  completedAt DateTime?
  etaMinutes  Int            @default(5)
  distanceKm  Float          @default(1.5)
  notes       String?
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resource    Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  assigner    User?          @relation(fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([resourceId])
  @@index([status])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  incidentId String?
  type       String
  title      String
  message    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?    // Native JSONB
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
