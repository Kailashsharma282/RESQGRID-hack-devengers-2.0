# ==========================================
# RESQGRID API PRODUCTION CONFIGURATION
# Platform: ResQGrid Emergency Operations API
# Hackathon: Hack Devengers 2.0
# Author: POCHIRAJU KAILASH RAM MARKANDEYA SHARMA
# ==========================================

NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://resqgrid.vercel.app

# ==========================================
# DATABASE: NEON DB (PostgreSQL Serverless)
# ==========================================
# 1. Pooled Connection (PgBouncer) for high-concurrency runtime queries:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. Direct Unpooled Connection for Prisma migrations & schema push:
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local SQLite Zero-Setup Dev Fallback:
# DATABASE_URL="file:./dev.db"

# ==========================================
# STORAGE: AWS S3 / CLOUDFLARE R2
# ==========================================
# Set provider to "s3" for AWS/R2 or "local" for disk uploads:
STORAGE_PROVIDER=s3
STORAGE_DIR=./uploads

# AWS S3 / Cloudflare R2 Credentials:
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key
AWS_S3_BUCKET_NAME=resqgrid-emergency-media

# Custom endpoint (leave empty for AWS S3; required for Cloudflare R2 / MinIO):
# AWS_S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# ==========================================
# AUTHENTICATION & RATE LIMITING
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_production_secure_jwt_random_secret_string_2026
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ==========================================
# AI ENGINE (OPENAI / DETERMINISTIC HEURISTIC)
# ==========================================
# Provider: "openai" for GPT-4o or "mock" for offline deterministic heuristics
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# ==========================================
# OBSERVABILITY & METRICS
# ==========================================
ENABLE_PROMETHEUS_METRICS=true
