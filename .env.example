# ==========================================
# RESQGRID PRODUCTION ENVIRONMENT TEMPLATE
# Platform: ResQGrid - AI Emergency Operations Platform
# Hackathon: Hack Devengers 2.0
# Author: POCHIRAJU KAILASH RAM MARKANDEYA SHARMA
# ==========================================

NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://resqgrid.vercel.app

# ==========================================
# DATABASE: NEON DB (PostgreSQL Serverless)
# ==========================================
# Pooled connection string with PgBouncer for serverless query scaling:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-subdomain-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct unpooled connection string for migrations:
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-subdomain.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local Zero-Friction Dev Fallback:
# DATABASE_URL="file:./dev.db"

# ==========================================
# STORAGE: AWS S3 / CLOUDFLARE R2
# ==========================================
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=resqgrid-emergency-media
# AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_production_secure_jwt_random_string_2026
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ==========================================
# AI INTELLIGENCE API (OPTIONAL)
# ==========================================
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-your-api-key
LLM_MODEL=gpt-4o-mini
